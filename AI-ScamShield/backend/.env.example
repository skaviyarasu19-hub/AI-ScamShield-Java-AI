# Copy this file to .env (or set as real environment variables / IDE run config)
# NEVER commit real secrets to source control.

# ---------------- Database ----------------
# Local default is file-backed H2. To use MySQL, set DB_URL and driver:
# DB_URL=jdbc:mysql://localhost:3306/scamshield_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC
# DB_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
DB_NAME=scamshield_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ---------------- Server ----------------
SERVER_PORT=8080

# ---------------- JWT ----------------
JWT_SECRET=replace-with-a-long-random-secret-string-min-32-chars
JWT_EXPIRATION_MS=86400000

# ---------------- AI Provider (optional) ----------------
# Leave AI_PROVIDER_ENABLED=false (or AI_PROVIDER_API_KEY empty) to run
# entirely on the local offline NLP fallback engine - no key required.
AI_PROVIDER_ENABLED=false
AI_PROVIDER_API_KEY=
AI_PROVIDER_URL=https://api.anthropic.com/v1/messages
AI_PROVIDER_MODEL=claude-sonnet-4-6
AI_PROVIDER_TIMEOUT_MS=8000

# ---------------- CORS ----------------
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# ---------------- Local NLP weighting (optional) ----------------
# All multipliers default to 1.0; risk scores remain deterministic.
SCAM_SAFE_MAX_RISK=24
SCAM_SUSPICIOUS_MAX_RISK=59
SCAM_WEIGHT_URGENCY=1.0
SCAM_WEIGHT_FINANCIAL=1.0
SCAM_WEIGHT_CREDENTIAL=1.0
SCAM_WEIGHT_REWARD=1.0
SCAM_WEIGHT_JOB=1.0
SCAM_WEIGHT_IMPERSONATION=1.0
SCAM_WEIGHT_PERSONAL_INFORMATION=1.0
SCAM_WEIGHT_LINK=1.0
SCAM_WEIGHT_URL=1.0
SCAM_WEIGHT_SENDER=1.0
SCAM_WEIGHT_STYLE=1.0
